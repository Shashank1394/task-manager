// Prisma Schema
// DevPilot — Developer Portal

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum Role {
  ADMIN
  MEMBER
  CLIENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum RepoProvider {
  GITHUB
}

enum SyncDirection {
  IMPORTED
  EXPORTED
  BIDIRECTIONAL
}

enum GitHubSyncAction {
  ISSUE_IMPORTED
  ISSUE_UPDATED
  ISSUE_EXPORTED
  PR_LINKED
  COMMIT_LINKED
  BRANCH_CREATED
  WEBHOOK_RECEIVED
  WEBHOOK_SETUP
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

// MODELS

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime @default(now())

  accounts      Account[]
  sessions      Session[]

  memberships    OrganizationMember[]
  assignedTasks  Task[]
  comments       Comment[]
  clientProjects ProjectClient[]
  activities     Activity[]
  notifications  Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members  OrganizationMember[]
  projects Project[]
}

model OrganizationMember {
  id             String @id @default(cuid())
  role           Role   @default(MEMBER)

  userId         String
  organizationId String

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  board          Board?

  repoProvider   RepoProvider?
  repoOwner      String?
  repoName       String?

  webhookSecret  String?
  webhookId      Int?

  githubIssues   GitHubIssue[]
  githubPRs      GitHubPR[]
  githubCommits  GitHubCommit[]
  githubSyncLogs GitHubSyncLog[]
  clients        ProjectClient[]
  sprints        Sprint[]
  activities     Activity[]
}

model ProjectClient {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Sprint {
  id        String       @id @default(cuid())
  name      String
  goal      String?
  status    SprintStatus @default(PLANNING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())

  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks     Task[]
}

model Board {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks     Task[]
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority       TaskPriority  @default(MEDIUM)
  dueDate        DateTime?
  estimatedHours Float?
  loggedHours    Float         @default(0)
  createdAt      DateTime      @default(now())

  boardId     String
  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?         @relation(fields: [assigneeId], references: [id])

  sprintId    String?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  comments    Comment[]
  labels      Label[]
  subtasks    Subtask[]

  githubIssueUrl String?
  githubIssue    GitHubIssue?
  githubPRs      GitHubPR[]
  githubCommits  GitHubCommit[]
  activities     Activity[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Label {
  id    String @id @default(cuid())
  name  String
  color String @default("#6366f1")

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, name])
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model GitHubIssue {
  id                 String        @id @default(cuid())
  githubIssueId      BigInt
  githubIssueNumber  Int
  syncDirection      SyncDirection @default(IMPORTED)
  lastSyncedAt       DateTime      @default(now())

  taskId             String        @unique
  task               Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  projectId          String
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, githubIssueNumber])
}

model GitHubSyncLog {
  id        String           @id @default(cuid())
  action    GitHubSyncAction
  details   Json?
  createdAt DateTime         @default(now())

  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GitHubPR {
  id              String   @id @default(cuid())
  githubPrId      BigInt
  githubPrNumber  Int
  title           String
  state           String   // open, closed, merged
  url             String
  authorLogin     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, githubPrNumber])
}

model GitHubCommit {
  id              String   @id @default(cuid())
  sha             String
  message         String
  authorName      String?
  authorDate      DateTime?
  url             String
  createdAt       DateTime @default(now())

  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sha])
}

// ─── Activity Feed ───────────────────────────────────────────

model Activity {
  id        String   @id @default(cuid())
  type      String   // TASK_CREATED, TASK_MOVED, TASK_ASSIGNED, COMMENT_ADDED, SPRINT_STARTED, etc.
  message   String
  meta      Json?    // extra data (e.g. { from: "TODO", to: "IN_PROGRESS" })
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  type      String   // TASK_ASSIGNED, MENTIONED, DEADLINE_APPROACHING, TASK_COMPLETED, etc.
  message   String
  link      String?  // URL to navigate to
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
